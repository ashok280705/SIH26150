# ==============================================================================
# VidForge Dashboard Environment Configuration (Vercel)
# ==============================================================================
# Add these variables to your Vercel Project Settings > Environment Variables

# Main Deployed Render Web & API Service
VIDFORGE_RENDER_URL=https://vidforge-forensics.onrender.com

# Direct API & Health Check URLs
VIDFORGE_API_URL=https://vidforge-forensics.onrender.com/api
VIDFORGE_HEALTH_URL=https://vidforge-forensics.onrender.com/health

# GitHub Repository & Documentation URLs
VIDFORGE_GITHUB_URL=https://github.com/ashok280705/VIDEO
VIDFORGE_DOCS_URL=https://github.com/ashok280705/VIDEO/blob/feature/windows-desktop/DATAIO_IMPLEMENTATION_AUDIT.md
