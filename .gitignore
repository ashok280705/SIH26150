*.raw
*.dd
*.img
*.E01
*.e01
*.Ex01
*.ex01
*.dmg
*.vmdk

# Rust
/target/
**/target/
*.pdb

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# Python (services/ai)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example

# Generated reports and exports (derived artifacts live outside the evidence dir)
/exports/
/reports/

