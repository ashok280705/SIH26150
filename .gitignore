# ---------------------------------------------------------------------------
# EVIDENCE — NEVER COMMIT
# `cases/` holds local dev/test cases and acquired evidence images. Evidence and
# case working data must never enter version control.
# ---------------------------------------------------------------------------
cases/

# Evidence image formats, wherever they land
*.raw
*.dd
*.img
*.E01
*.e01
*.Ex01
*.ex01
*.dmg
*.vmdk

# Rust
/target/
**/target/
*.pdb

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Bundled offline assistant runtime (Ollama). The binary and quantized models
# are large and machine-specific — fetched per-machine by scripts/ollama/setup.
# Only vendor/ollama/README.md is committed.
# ---------------------------------------------------------------------------
/vendor/ollama/bin/
/vendor/ollama/dist/
/vendor/ollama/lib/
/vendor/ollama/models/

# Real source footage used to build the sample DVR image (may be large / licensed).
# Only the generator script is committed; the clips themselves are fetched per-machine.
/footage/

# Python (services/ai)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example

# Generated reports and exports (derived artifacts live outside the evidence dir)
/exports/
/reports/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.db-wal
*.db-shm
