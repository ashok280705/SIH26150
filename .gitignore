# ---------------------------------------------------------------------------
# EVIDENCE — NEVER COMMIT
# `cases/` holds local dev/test cases and acquired evidence images. Evidence and
# case working data must never enter version control.
# ---------------------------------------------------------------------------
cases/

# Evidence image formats, wherever they land
*.raw
*.dd
*.img
*.E01
*.e01
*.Ex01
*.ex01
*.dmg
*.vmdk
!evidence_samples/*.raw

# Rust
/target/
**/target/
*.pdb

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Bundled offline assistant runtime (Ollama). The binaries, shared libraries and
# quantized models are large and machine-specific — fetched per-machine by
# scripts/ollama/setup. Only vendor/ollama/README.md is committed.
# ---------------------------------------------------------------------------
/vendor/ollama/*
!/vendor/ollama/README.md

# Real source footage used to build the sample DVR image (may be large / licensed).
# Only the generator script is committed; the clips themselves are fetched per-machine.
/footage/

# Python (services/ai)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example

# Generated reports and exports (derived artifacts live outside the evidence dir)
/exports/
/reports/

# Generated implementation audit — produced on demand, not a committed artifact.
/PROJECT_IMPLEMENTATION_AUDIT.md

# Verification runner output — regenerated per machine by scripts/verify_*.{sh,ps1}.
# The runners and the docs they execute ARE committed; a single machine's result is not.
/UNIVERSAL_RECOVERY_VERIFICATION_RESULT.md
/MEDIA_PIPELINE_VERIFICATION_RESULT.md
/universal_recovery_console.log
/media_verification_console.log

# SQLite databases — runtime metadata stores, never version-controlled.
# (These are regenerated by the API on startup; the 100+ MB forensic_metadata.db
# is what previously blocked pushes.)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Binaries and executables — large binaries (>100MB) exceeding GitHub limits.
*.exe
/runtime/**/*.exe

